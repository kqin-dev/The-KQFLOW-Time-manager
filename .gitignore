/.gomodcache/

# 开发期渲染预览
/preview.txt
/preview.txt.*.txt

# 本地数据目录（真正的数据库不应进版本库）
/kqflow-data/
**/kqflow-data/
# 同上：改名前的数据目录名
/kairos-data/
**/kairos-data/

# 编辑器与系统文件
